# BUILD & RUN COMMANDS:
# ---------------------
# ATTENTION: The build commands should be launched being in this project root directory.
#
# To rebuild the image with removal of the previous build:
#   docker compose -f .devcontainer/docker-compose.yml build --pull --no-cache
#
# To redirect all build output to build.log file:
#   > build.log && docker compose -f .devcontainer/docker-compose.yml build --pull --no-cache > build.log 2>&1
#
# To run the image in interactive mode:
#   docker compose -f .devcontainer/docker-compose.yml run --rm app /bin/bash
#
# LOCAL IMAGE INFO:
# -----------------
# Optional local compose image tag:
#   devcontainer:local
#
# IMAGES, CONTAINERS & VOLUMES INFO COMMANDS:
# -------------------------------------------
# To list all images (without intermediate ones which does not spend dick space):
#   docker image ls
#
# To list all images (even with intermediate ones):
#   docker image ls --all
#
# To list all containers (even with temporary ones which are preserved even after
# they are stopped, see https://stackoverflow.com/a/56537550/1245149):
#   docker container ls --all --size --format "table {{.Names}}\t{{.Size}}\t{{.Status}}"
#
# To list all volumes:
#   docker volume ls
#
# To find size of all volumes inspect some of volumes at first to find a path to all volumes directories
# and then use `du` (disk usage) to find out spent disk spage (e.g. for docker volumes on linux):
#   docker volume inspect <volume_name>
#   sudo du -sh /var/lib/docker/volumes/
# Or for given <volume_name>:
#   sudo du -sh /var/lib/docker/volumes/<volume_name>
#
# IMAGES, CONTAINERS, NETWORKS & VOLUMES CLEANUP COMMANDS:
# --------------------------------------------------------
# To clean up disk space remove at first temporary containers (otherwise their existence
# will block removal of dangling images) and then remove dangling images:
#   docker container prune
#   docker image prune
#
# To remove all unused images (not just the dangling ones):
#   docker image prune --all
#
# To remove an image by its id:
#   docker image rm <image_id>
#
# ATTENTION: Be careful with volumes removal (and DO NOT USE at all `docker volume prune` which
# removes all ACTUALLY unused volumes) because very probably you will lost your data (mostly some databases).
# Images and containers are easily reproducible (building from Dockerfile or cloning from hub.docker.com),
# but this is not the case of volumes.
#
# To remove an volume by its name:
#   docker volume rm <volume_name>
#
# To cleanup builder cache:
#   docker builder prune
#
# ATTENTION: If you get an error "all predefined address pools have been fully subnetted" on devcontainer start,
# then remove all unused networks:
#   docker network prune
#
# NOTE: If there is some missing <command> in this docker image then try `busybox <command>`.

FROM ubuntu:noble-20251013

# Use to check the actual version of image inside of container
ARG IMAGE_VERSION=devcontainer:local
ENV IMAGE_VERSION=${IMAGE_VERSION}

# Let the scripts running in docker container using this image to know that
# they are running in docker container on localhost (it means in development mode).
# Possible values of this variable are onLocalhost, inProduction.
ENV IN_DOCKER=onLocalhost

# Use UTF-8 locale so interactive terminals handle non-ASCII input correctly.
ENV LANG=C.utf8 \
    LC_ALL=C.utf8

RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    # Install following additional linux packages:
    && apt-get install -y --no-install-recommends \
        # `sudo` to allow super user operations
        sudo \
        # `bash-completion` to allow `make` command auto-completion
        bash-completion \
        # `hg` (Mercurial)
        mercurial \
        # `git` to make image usable also for other than fajnwork projects
        git \
        # `openssh-client` to enable ssh command
        openssh-client \
        # `ca-certificates`, `curl` to allow `curl` command
        ca-certificates curl \
        # `less` to view files in less
        less \
        # linux tools, e.g. `busybox vi` (vi), `busybox less` (less), `busybox grep` (grep), etc.
        busybox \
        # `bubblewrap` is used by `codex` CLI
        bubblewrap \
        # `libatomic1` is required by Node.js 25+ as a runtime dependency
        libatomic1 \
        # `ffmpeg` to process audio and video files
        ffmpeg \
        # `gcc` and `python3-dev` to compile Python C extensions (e.g. webrtcvad used by resemblyzer)
        gcc \
        python3-dev \
        # OCR and PDF conversion
        tesseract-ocr \
        tesseract-ocr-slk \
        tesseract-ocr-ces \
        tesseract-ocr-eng \
        poppler-utils \
        # `wv` (wvHtml) reads the binary `.doc` technical reports that come with
        # projects having no bill of quantities (task 0061). All 14 `.doc` files
        # under `data/` are OLE2, so `python-docx` cannot open any of them.
        # wvHtml emits real <table>/<tr>/<td>, which the stdlib `html.parser`
        # then reads - no extra Python dependency. It costs ~1 MB against the
        # ~400 MB of LibreOffice, which stays unused and is kept only as the
        # emergency path for EMF/WMF images.
        wv \
        # `pip` for Python package management (python3 is pre-installed in Ubuntu Noble)
        python3-pip \
        # `venv` for the throwaway environments the packaging guide uses
        # (`python -m build` and installing the wheel into a clean venv, see
        # agent/README.md). Present transitively via pipx, declared because we
        # depend on it. Note there is no project virtualenv - see task 0052.
        python3-venv \
        # `pipx` to install Python CLI tools in isolated environments
        pipx \
    # Make `python` an alias for `python3`
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    # Clean up the package manager's local repository of retrieved package files
    # and remove the package lists that were downloaded earlier
    # to reduce the size of the final Docker image
    && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# ODA File Converter: the DWG -> DXF step of the drawing pipeline (task 0040).
#
# The package is downloaded at build time from a project-controlled mirror, so a
# fresh clone builds with nothing to prepare by hand. It cannot come from ODA
# directly: opendesign.com serves the converter behind a registration form and
# per-session URLs, and it publishes only the current release - a link there is
# neither stable nor reachable from a build. The mirror pins one known version
# instead, which is also what makes the build reproducible.
#
# ODA_SHA256 is the contract with that mirror. The URL is plain HTTP and the
# host is ours to change, so the digest is what actually decides whether the
# 56 MB that arrived is the package this image was tested against. To move to a
# new converter release, change both ARGs together - the version alone fails.
#
# Both are ARGs so a build can point at a different mirror or version without
# editing this file:
#   docker compose build --build-arg ODA_URL=... --build-arg ODA_SHA256=...
#
# The download and the install share one RUN layer, and the .deb is removed
# inside it. Splitting them would leave the package in its own layer forever,
# even after a later `rm` - layers only ever add.
#
# The package declares no `Depends` at all and bundles its own Qt 6, so apt
# resolves nothing for it. It ships a single platform plugin, `libqxcb.so` (no
# offscreen plugin), so an X server stays mandatory - that is what `xvfb` is
# for - and the plugin needs the six X11 libraries below. The list comes from
# `ldd` on the bundled plugin; `libxcb-util.so.0`, which ODA's own release notes
# mention as a workaround for modern Ubuntu, is not among them.
#
# The `chmod` calls repair the package's own permissions: it installs its tree,
# `/usr/share/doc/ODAFileConverter` and even the shared `/usr/share/icons` and
# `icons/hicolor` as world-writable (15 paths, 12 of them directories). A
# world-writable `plugins/platforms/` lets anyone drop a Qt plugin that the
# converter then loads, and a world-writable `qt.conf` can redirect the plugin
# search path. Symbolic `go-w` is deliberate - it strips only the write bits and
# leaves execute alone. The `test` that follows keeps the fix honest if a future
# package version adds new paths.
#
# The closing `command -v` makes a broken install fail the build here instead of
# at the first conversion.
ARG ODA_URL=http://shared.run.sk/files/ODAFileConverter_QT6_lnxX64_8.3dll_27.1.deb
ARG ODA_SHA256=c71363cd54758177af47a365154f180dc50a1e2b52a131994fda541c13a36766
RUN set -eux; \
    test "$(dpkg --print-architecture)" = "amd64"; \
    package=/tmp/ODAFileConverter.deb; \
    if ! curl -fsSL --retry 3 --retry-connrefused -o "${package}" "${ODA_URL}"; then \
        echo "error: could not download the ODA File Converter from:" >&2; \
        echo "  ${ODA_URL}" >&2; \
        echo "Check the network, or point the build at another copy:" >&2; \
        echo "  docker compose build --build-arg ODA_URL=... --build-arg ODA_SHA256=..." >&2; \
        exit 1; \
    fi; \
    if ! echo "${ODA_SHA256}  ${package}" | sha256sum -c -; then \
        echo "error: the downloaded package does not match ODA_SHA256." >&2; \
        echo "Expected ${ODA_SHA256}" >&2; \
        echo "Got      $(sha256sum < "${package}" | cut -d' ' -f1)" >&2; \
        echo "The mirror served something else. Do not install it: verify the" >&2; \
        echo "source, then update ODA_URL and ODA_SHA256 together." >&2; \
        exit 1; \
    fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        xvfb \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${package}"; \
    rm -f "${package}"; \
    chmod go-w /usr/share/icons; \
    chmod -R go-w /usr/bin/ODAFileConverter /usr/bin/ODAFileConverter_*/ \
                  /usr/share/doc/ODAFileConverter /usr/share/icons/hicolor; \
    test "$(find /usr/bin/ODAFileConverter /usr/bin/ODAFileConverter_*/ \
                 /usr/share/icons -perm -o+w | wc -l)" = "0"; \
    command -v ODAFileConverter; \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Pin the Qt platform plugin. VS Code Dev Containers exports WAYLAND_DISPLAY, so
# Qt tries the "wayland" plugin first, but the ODA package ships only
# `libqxcb.so` - the probe can therefore only fail, and it prints a warning to
# stderr. That warning is not cosmetic: on Linux `ezdxf.addons.odafc` treats any
# non-empty stderr as a failed conversion (odafc.py, `_odafc_failed`), so a
# perfectly good DWG comes back as UnknownODAFCError with "return code = 0".
# Naming the only available plugin removes the probe and keeps stderr empty.
ENV QT_QPA_PLATFORM=xcb

# --- Python packages -------------------------------------------------------
#
# These two layers come LAST among the root-user steps on purpose (task 0054).
# Docker invalidates the layer you changed and everything after it, and these are
# the files we edit most often: with the pip layer placed BEFORE the ODA install,
# a one-line change to requirements.txt also rebuilt ODA and cost 87 s instead of
# 6 s. Stable steps first, volatile last.
#
# They must stay above `USER ubuntu`: pip run as an unprivileged user silently
# installs into ~/.local, which lives in the container's writable layer and is lost
# on every rebuild. That is exactly the defect this task removes - as root the
# packages land in /usr/local/lib/python3.12/dist-packages, inside the image.
#
# `--break-system-packages` is required because the interpreter is apt-managed
# (PEP 668). It is safe here and not a hack we regret: this container is
# disposable and rebuilt often, so a conflict with an apt `python3-*` upgrade is
# resolved by rebuilding instead of by hand.
#
# The package lists are written inline rather than read from a requirements file,
# so this Dockerfile builds on its own with no build context to prepare. Each
# list is a heredoc: pins stay one-per-line and reviewable, and the file never
# enters an image layer.

# Dependencies that no pyproject.toml owns (task 0052).
#
# Everything the `agent` package needs - openai-codex and the dev tools - is
# declared in agent/pyproject.toml and arrives with the editable install that
# post-create.sh performs. Do not repeat it here.
#
# Everything below lives here only until a domain package with its own
# pyproject.toml exists; task 0056 decides where that package goes. Versions are
# pinned because these modules are read as contracts, not as documentation.
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /dev/stdin <<'EOF'
# `ezdxf.addons.odafc` is the working interface to ODA File Converter - notably
# it runs the converter without a timeout, which the caller has to supply
# (task 0051).
ezdxf==1.4.4

# Cost-estimation input formats (task 0061). The `.doc` reader is not here: it is
# the apt package `wv`, installed above.

# Reads both `.xlsx` and `.xls` through one interface, which is why it replaced
# the `xlrd` + external-converter pair. Verified on the real files under `data/`:
# a 16-sheet `.xls` opens directly, and a CENKROS export is read out to column 91
# - the range where prices hide well past `I:J`.
python-calamine==0.8.2

# Writes the auditable XLSX report. Read-only work goes through calamine above;
# `openpyxl` cannot read `.xls` at all.
openpyxl==3.1.5

# Text, tables and word coordinates from PDF - the technical reports and drawing
# legends that carry meaning no drawing holds. Verified on `data/`: a floor plan
# yields its `LEGENDA ZNAČIEK` and 8 tables.
pdfplumber==0.11.10
EOF

# Pinned closure of `agent[dev]` and the build backend (task 0054). `agent` itself
# is NOT installed here - an editable install records a path under /mnt, which is
# not mounted at build time - but with its dependencies and hatchling already
# present, post-create.sh can bind the package offline and in seconds.
#
# `packaging` goes first and separately: the base image carries it as the dpkg
# package `python3-packaging` (24.0), pip cannot uninstall a dpkg-managed package
# ("RECORD file not found"), and `hatchling` needs >=24.2 - so a plain install of
# the lock aborts. `--ignore-installed` leaves dpkg's copy alone and puts the newer
# one in /usr/local/lib/python3.12/dist-packages, which sys.path reaches BEFORE
# /usr/lib/python3/dist-packages, so it wins. `pipx` is the only dpkg dependent and
# asks for >=20, so it keeps working. Its pin is repeated in the list below - keep
# the two in step when regenerating.
#
# The closure is DERIVED: agent/pyproject.toml stays the source of direct
# dependencies, and this list only freezes what they resolve to. Regenerate after
# changing them, and paste the result back into this heredoc:
#
#   python3 -m pip install --dry-run --ignore-installed --quiet \
#       --report /tmp/devlock.json "./agent[dev]" hatchling editables
#   python3 -c "import json; r=json.load(open('/tmp/devlock.json')); \
#       print('\n'.join(sorted(f\"{i['metadata']['name']}=={i['metadata']['version']}\" \
#       for i in r['install'] if i['metadata']['name'].lower() != 'agent')))"
#
# Drift against agent/pyproject.toml is caught automatically: after the editable
# install, `pip check` reports any requirement the closure fails to satisfy.
RUN set -eux; \
    python3 -m pip install --no-cache-dir --break-system-packages \
        --ignore-installed "packaging==26.2"; \
    python3 -m pip install --no-cache-dir --break-system-packages -r /dev/stdin <<'EOF'
# Pinned closure of `agent[dev]` plus the build backend (task 0054).
# `agent` itself is deliberately absent: post-create.sh installs it editable
# from /mnt/agent, which cannot happen at build time.
annotated-types==0.8.0
ast_serialize==0.6.0
editables==0.6
hatchling==1.31.0
iniconfig==2.3.0
librt==0.13.0
mypy==2.3.0
mypy_extensions==1.1.0
openai-codex==0.144.4
openai-codex-cli-bin==0.144.4
packaging==26.2
pathspec==1.1.1
pluggy==1.6.0
pydantic==2.13.4
pydantic_core==2.46.4
pygments==2.20.0
pytest==9.1.1
ruff==0.16.0
trove-classifiers==2026.6.1.19
typing-inspection==0.4.2
typing_extensions==4.16.0
EOF

# Marker that this image is for development (task 0066). File logging keys off
# this file and nothing else: an environment variable like IN_DOCKER can be set
# by anyone, whereas the delivery image simply never contains this path - so it
# has to forbid nothing, and the refusal is the default side.
RUN mkdir -p /etc/agent \
    && printf 'devcontainer\n' > /etc/agent/dev-profile

# Allow ubuntu user to execute sudo without a password
RUN echo "ubuntu ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/ubuntu

# Use the created user to run the container
USER ubuntu

# Add user-local bin to PATH (for pip-installed scripts)
ENV PATH="/home/ubuntu/.local/bin:$PATH"

# Create a directory for the workspaces
RUN mkdir -p /home/ubuntu/workspaces

# Create the `preserved` directory where are stored all user
# files which should be preserved in named volume
RUN mkdir -p /home/ubuntu/preserved
# Set the bash history file to preserved location
ENV HISTFILE=/home/ubuntu/preserved/.bash_history

# Create directory for VS Code global storage data
# to preserve them even after the container is rebuild
# NOTE: It is created here explicitly to ensure it has `ubuntu` as owner.
# Otherwise it would be created with `root` as owner because it is mapped to named volume in docker-compose.yml.
RUN mkdir -p /home/ubuntu/.vscode-server/data/User/globalStorage

# Create empty config files and tool state directories in user's home directory
# NOTE: Created here explicitly to ensure they have `ubuntu` as owner.
RUN touch /home/ubuntu/.hgrc \
    && touch /home/ubuntu/.gitconfig \
    && mkdir -p /home/ubuntu/.ssh \
    && mkdir -p /home/ubuntu/.codex \
    && mkdir -p /home/ubuntu/.claude \
    # Mount point for the Claude Code payload volume (task 0054). Created here so
    # the volume inherits the ubuntu user instead of root.
    && mkdir -p /home/ubuntu/.local/share/claude

# Install nvm and Node 24 for ubuntu user.
ENV NVM_DIR="/home/ubuntu/.nvm"
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 24 \
    && nvm alias default 24 \
    # Create stable symlink to default bin dir for ENV PATH below
    && ln -sf "$(dirname "$(nvm which default)")" "$NVM_DIR/default-bin"
ENV PATH="$NVM_DIR/default-bin:$PATH"

WORKDIR /mnt
