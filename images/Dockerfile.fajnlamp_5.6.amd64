# BUILD & RUN COMMANDS:
# ---------------------
# ATTENTION: The build commands should be launched being in this file directory.
#
# To rebuild the image with removal of the previous build:
#   docker rmi developmentrunsk/fajnlamp:5.6 --force && docker build --pull --no-cache --build-arg IMAGE_VERSION=fajnlamp:5.6-$(date -u +%Y%m%d%H%M%S) -t developmentrunsk/fajnlamp:5.6 -f Dockerfile.fajnlamp_5.6.amd64 .
#
# To redirect all build output to build.log file:
#   docker rmi developmentrunsk/fajnlamp:5.6 --force && > build.log && docker build --pull --no-cache --build-arg IMAGE_VERSION=fajnlamp:5.6-$(date -u +%Y%m%d%H%M%S) -t developmentrunsk/fajnlamp:5.6 -f Dockerfile.fajnlamp_5.6.amd64 . > build.log 2>&1
#
# To run the image in interactive mode:
#   docker run -it developmentrunsk/fajnlamp:5.6 /bin/bash
#
# PUBLISH ON DOCKERHUB:
# ---------------------
# To push the image to https://hub.docker.com/r/developmentrunsk/fajnlamp:
#   docker login
#   docker push developmentrunsk/fajnlamp:5.6
#   docker logout
#
# IMAGES, CONTAINERS & VOLUMES INFO COMMANDS:
# -------------------------------------------
# To list all images (without intermediate ones which does not spend dick space):
#   docker image ls
#
# To list all images (even with intermediate ones):
#   docker image ls --all
#
# To list all containers (even with temporary ones which are preserved even after
# they are stopped, see https://stackoverflow.com/a/56537550/1245149):
#   docker container ls --all --size --format "table {{.Names}}\t{{.Size}}\t{{.Status}}"
#
# To list all volumes:
#   docker volume ls
#
# To find size of all volumes inspect some of volumes at first to find a path to all volumes directories
# and then use `du` (disk usage) to find out spent disk spage (e.g. for docker volumes on linux):
#   docker volume inspect <volume_name>
#   sudo du -sh /var/lib/docker/volumes/
# Or for given <volume_name>:
#   sudo du -sh /var/lib/docker/volumes/<volume_name>
#
# IMAGES, CONTAINERS, NETWORKS & VOLUMES CLEANUP COMMANDS:
# --------------------------------------------------------
# To clean up disk space remove at first temporary containers (otherwise their existence
# will block removal of dangling images) and then remove dangling images:
#   docker container prune
#   docker image prune
#
# To remove all unused images (not just the dangling ones):
#   docker image prune --all
#
# To remove an image by its id:
#   docker image rm <image_id>
#
# ATTENTION: Be careful with volumes removal (and DO NOT USE at all `docker volume prune` which
# removes all ACTUALLY unused volumes) because very probably you will lost your data (mostly some databases).
# Images and containers are easily reproducible (building from Dockerfile or cloning from hub.docker.com),
# but this is not the case of volumes.
#
# To remove an volume by its name:
#   docker volume rm <volume_name>
#
# To cleanup builder cache:
#   docker builder prune
#
# ATTENTION: If you get an error "all predefined address pools have been fully subnetted" on devcontainer start,
# then remove all unused networks:
#   docker network prune
#
# NOTE: If there is some missing <command> in this docker image then try `busybox <command>`.
FROM php:5.6-apache-stretch

# Use to check the actual version of image inside of container
ARG IMAGE_VERSION=fajnlamp:5.6-202606031316
ENV IMAGE_VERSION=${IMAGE_VERSION}

# Let the scripts running in docker container using this image to know that
# they are running in docker container on localhost (it means in development mode).
# Possible values of this variable are onLocalhost, inProduction.
ENV IN_DOCKER=onLocalhost
# Make the IN_DOCKER variable available in the Apache environment so in .htaccess like %{ENV:IN_DOCKER}
RUN echo "export IN_DOCKER=$IN_DOCKER" >> /etc/apache2/envvars

# point apt sources to an archived version of the Debian Stretch repositories
RUN sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list \
    && sed -i '/debian-security/d' /etc/apt/sources.list \
    && sed -i '/stretch-updates/d' /etc/apt/sources.list \
    && apt-get update -o Acquire::Check-Valid-Until=false

RUN apt-get update -o Acquire::Check-Valid-Until=false && export DEBIAN_FRONTEND=noninteractive \
    # Install following additional linux packages:
    && apt-get install -y --no-install-recommends --allow-unauthenticated \
        # `sudo` to allow super user operations
        sudo \
        # `bash-completion` to allow `make` command auto-completion
        bash-completion \
        # `hg` (Mercurial)
        mercurial \
        # `git` to make image usable also for other than fajnwork projects
        git \
        # `openssh-client` to enable ssh command
        openssh-client \
        # `curl` to allow use of `curl` command
        curl \
        # linux tools, e.g. `busybox vi` (vi), `busybox less` (less), `busybox grep` (grep), etc.
        busybox \
        # `gawk` replaces default `mawk` as /usr/bin/awk; required by Codex
        # CLI installer which uses interval regex `{64}` not supported by mawk
        # (see https://github.com/openai/codex/issues/24219)
        gawk \
        # `bubblewrap` is used by `codex` CLI
        bubblewrap \
        # `libatomic1` is required by Node.js 25+ as a runtime dependency
        libatomic1 \
        # `mysql` to allow access and import DB:
        # - `mysql -u root -proot -h db --default-character-set=utf8 -D project`
        # - `SOURCE dumpfile.sql`
        mariadb-client \
        # libraries needed for GD.
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        # library needed for imagick (installed here below using pecl).
        libmagickwand-dev --no-install-recommends \
        # library needed for ssh2 (installed here below using pecl).
        libssh2-1-dev \
        # library needed for xsl (installed here below).
        libxslt-dev \
        # library needed for zip (installed here below).
        libzip-dev \
        # library needed for mcrypt (replacing openssl).
        libmcrypt-dev \
        # `python3-pip` needed to install pipx here below
        python3-pip \
        # `python3-venv` is required by `pipx` to create isolated environments
        python3-venv \
        # `jq` is like `grep`/`awk` but for JSON
        jq \
    # Clean up the package manager's local repository of retrieved package files
    # and remove the package lists that were downloaded earlier
    # to reduce the size of the final Docker image
    && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Enable Apache modules
RUN a2enmod mime \
    && a2enmod rewrite \
    && a2enmod deflate \
    && a2enmod proxy proxy_http \
    && a2enmod headers \
    && a2enmod expires

# Enable .htaccess overrides
RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf

# Install necessary PHP extensions (use `php -m` to list all enabled)
RUN pecl install imagick && docker-php-ext-enable imagick \
    && pecl install ssh2-0.13 && docker-php-ext-enable ssh2 \
    && pecl install xdebug-2.5.5 && docker-php-ext-enable xdebug \
    && docker-php-ext-install bcmath bz2 calendar exif gettext intl mysqli opcache \
    && docker-php-ext-install pcntl pdo_mysql shmop soap sockets sysvmsg sysvsem sysvshm wddx xsl zip \
    && docker-php-ext-install mcrypt

# Configure and install GD extension with FreeType support
RUN docker-php-ext-configure gd --with-freetype-dir=/usr/include/ --with-jpeg-dir=/usr/include/ \
    && docker-php-ext-install gd

# Create php.ini using the development template
RUN cp $PHP_INI_DIR/php.ini-development $PHP_INI_DIR/php.ini

# Update PHP settings:
# - max_execution_time = 600
# - max_input_time = 60
# - memory_limit = 256M
# - post_max_size = 80M
# - upload_max_filesize = 80M
# - max_file_uploads = 20
RUN sed -i 's/^max_execution_time = .*/max_execution_time = 600/' $PHP_INI_DIR/php.ini \
    && sed -i 's/^max_input_time = .*/max_input_time = 60/' $PHP_INI_DIR/php.ini \
    && sed -i 's/^memory_limit = .*/memory_limit = 256M/' $PHP_INI_DIR/php.ini \
    && sed -i 's/^post_max_size = .*/post_max_size = 80M/' $PHP_INI_DIR/php.ini \
    && sed -i 's/^upload_max_filesize = .*/upload_max_filesize = 80M/' $PHP_INI_DIR/php.ini \
    && sed -i 's/^max_file_uploads = .*/max_file_uploads = 20/' $PHP_INI_DIR/php.ini

# Add extensions to php.ini for Apache
RUN echo "" >> $PHP_INI_DIR/php.ini \
    && echo "; custom directives:" >> $PHP_INI_DIR/php.ini \
    # Following is covered here above by `docker-php-ext-enable`.
    # Either do it manually here or by `docker-php-ext-enable`, but do not use both.
    #&& echo "extension=imagick.so" >> $PHP_INI_DIR/php.ini \
    #&& echo "extension=ssh2.so" >> $PHP_INI_DIR/php.ini \
    #&& echo "" >> $PHP_INI_DIR/php.ini \
    #&& echo "zend_extension=/usr/local/lib/php/extensions/no-debug-non-zts-20180731/xdebug.so" >> $PHP_INI_DIR/php.ini \
    && echo "xdebug.remote_enable = 1" >> $PHP_INI_DIR/php.ini \
    && echo "xdebug.remote_autostart = 1" >> $PHP_INI_DIR/php.ini \
    && echo "xdebug.remote_port = 9000" >> $PHP_INI_DIR/php.ini

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Create a group and user with specific UID/GID (1000:1000) to simulate a user on
# hosting system.
RUN groupadd -g 1000 developer \
    && useradd -u 1000 -g developer -m -s /bin/bash developer \
    # Allow developer user to execute sudo without a password
    && echo "developer ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/developer
# Change ownership of the web root and any other required directories
# This is to ensure the new user has access to these directories
RUN chown -R developer:developer /var/www
# Use the created user to run the container
USER developer

# Install pipx to install Python CLI tools in isolated environments
RUN pip3 install pipx

# Install nvm and Node.js 10 (Gitbook, Gulp), 17 (Gulp), 24 (Auggie)
ENV NVM_DIR="/home/developer/.nvm"
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 10 \
    && nvm install 17 \
    && nvm install 24 \
    && nvm alias default 24 \
    # Install GitBook and Gulp for Node.js 10
    && nvm use 10 \
    #&& npm install --global gitbook-cli \
    && npm install --global gulp-cli \
    # Install Gulp for Node.js 17
    && nvm use 17 \
    && npm install --global gulp-cli \
    # Create stable symlink to default bin dir for ENV PATH below
    && ln -sf "$(dirname "$(nvm which default)")" "$NVM_DIR/default-bin"

# Make default Node.js version available in all shells without sourcing nvm.sh
ENV PATH="$NVM_DIR/default-bin:$PATH"

# Make /home/developer/.local/bin  available in all shells
ENV PATH="/home/developer/.local/bin:$PATH"

# Create the `preserved` directory where are stored all user
# files which should be preserved in named volume
RUN mkdir -p /home/developer/preserved
# Set the bash history file to preserved location
ENV HISTFILE=/home/developer/preserved/.bash_history

# Create directory for VS Code global storage data (e.g. augment code threads)
# to preserve them even after the container is rebuild
# NOTE: It is created here explicitly to ensure it has `developer` as owner.
# Otherwise it would be created with `root` as owner because it is mapped to named volume in docker-compose.yml.
RUN mkdir -p /home/developer/.vscode-server/data/User/globalStorage

# Create empty config files and .ssh directory in user's home directory
# NOTE: Created here explicitly to ensure they have `developer` as owner.
RUN touch /home/developer/.hgrc \
    && touch /home/developer/.gitconfig \
    && mkdir -p /home/developer/.ssh

# Create a directory for shared node_modules
RUN mkdir /var/www/node_modules
