# BUILD & RUN COMMANDS:
# ---------------------
# ATTENTION: The build commands should be launched being in this project root directory.
#
# To rebuild the image with removal of the previous build:
#   docker compose -f .prodcontainer/docker-compose.yml build --pull --no-cache
#
# To redirect all build output to build.log file:
#   > build.log && docker compose -f .prodcontainer/docker-compose.yml build --pull --no-cache > build.log 2>&1
#
# To run the image in interactive mode:
#   docker compose -f .prodcontainer/docker-compose.yml run --rm app /bin/bash
#
# LOCAL IMAGE INFO:
# -----------------
# Optional local compose image tag:
#   prodcontainer:local
#
# IMAGES, CONTAINERS & VOLUMES INFO COMMANDS:
# -------------------------------------------
# To list all images (without intermediate ones which does not spend dick space):
#   docker image ls
#
# To list all images (even with intermediate ones):
#   docker image ls --all
#
# To list all containers (even with temporary ones which are preserved even after
# they are stopped, see https://stackoverflow.com/a/56537550/1245149):
#   docker container ls --all --size --format "table {{.Names}}\t{{.Size}}\t{{.Status}}"
#
# To list all volumes:
#   docker volume ls
#
# To find size of all volumes inspect some of volumes at first to find a path to all volumes directories
# and then use `du` (disk usage) to find out spent disk spage (e.g. for docker volumes on linux):
#   docker volume inspect <volume_name>
#   sudo du -sh /var/lib/docker/volumes/
# Or for given <volume_name>:
#   sudo du -sh /var/lib/docker/volumes/<volume_name>
#
# IMAGES, CONTAINERS, NETWORKS & VOLUMES CLEANUP COMMANDS:
# --------------------------------------------------------
# To clean up disk space remove at first temporary containers (otherwise their existence
# will block removal of dangling images) and then remove dangling images:
#   docker container prune
#   docker image prune
#
# To remove all unused images (not just the dangling ones):
#   docker image prune --all
#
# To remove an image by its id:
#   docker image rm <image_id>
#
# ATTENTION: Be careful with volumes removal (and DO NOT USE at all `docker volume prune` which
# removes all ACTUALLY unused volumes) because very probably you will lost your data (mostly some databases).
# Images and containers are easily reproducible (building from Dockerfile or cloning from hub.docker.com),
# but this is not the case of volumes.
#
# To remove an volume by its name:
#   docker volume rm <volume_name>
#
# To cleanup builder cache:
#   docker builder prune
#
# ATTENTION: If you get an error "all predefined address pools have been fully subnetted" on container start,
# then remove all unused networks:
#   docker network prune
#
# NOTE: If there is some missing <command> in this docker image then try `busybox <command>`.

FROM ubuntu:noble-20251013

# Use to check the actual version of image inside of container
ARG IMAGE_VERSION=prodcontainer:local
ENV IMAGE_VERSION=${IMAGE_VERSION}

# Let the scripts running in docker container using this image to know that
# they are running in docker container on localhost (it means in development mode).
# Possible values of this variable are onLocalhost, inProduction.
# Kept for compatibility with anything outside this repository that looks for it.
# Nothing here reads it: file logging keys off /etc/agent/dev-profile precisely
# because a variable like this one can be set by anyone (task 0066).
ENV IN_DOCKER=onLocalhost

# Use UTF-8 locale so interactive terminals handle non-ASCII input correctly.
ENV LANG=C.utf8 \
    LC_ALL=C.utf8

RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    # Install following additional linux packages:
    && apt-get install -y --no-install-recommends \
        # `sudo` to allow super user operations
        sudo \
        # `git` is NOT optional here, despite there being no repository inside the
        # container: the session transcript takes its author from
        # `git config user.name`, which is what tells two people's logs apart after
        # a merge (`observability/session_log.py`).
        git \
        # `ca-certificates`, `curl` to allow `curl` command
        ca-certificates curl \
        # `less` to view files in less
        less \
        # linux tools, e.g. `busybox vi` (vi), `busybox less` (less), `busybox grep` (grep), etc.
        busybox \
        # `bubblewrap` is used by `codex` CLI
        bubblewrap \
        # DROPPED for this image (task 0072). Each was checked, not assumed:
        #   bash-completion   was for `make`, which this project does not use
        #   mercurial         nothing here is an hg checkout
        #   openssh-client    `~/.ssh` is no longer mounted and nothing pushes
        #   libatomic1        a Node.js runtime dependency; Node is gone
        #   ffmpeg            no audio or video anywhere in this project
        #   gcc, python3-dev  the whole closure resolves to binary wheels - checked
        #                     with `pip download --only-binary=:all:` over
        #                     requirements.txt and the runtime lock, 28 of 28
        #   tesseract-ocr + slk/ces/eng, poppler-utils
        #                     no caller in the tree, and OCR was retired in favour
        #                     of a vision reader (task 0071)
        #   pipx, python3-venv
        #                     pipx installed the agent CLIs this image no longer
        #                     carries; venv came with it and served the packaging
        #                     guide, which now lives in `docs/client/`
        #
        # If one of these turns out to be needed, put it back with its reason. The
        # list above is what was verified, not what was believed.
        # `wv` (wvHtml) reads the binary `.doc` technical reports that come with
        # projects having no bill of quantities (task 0061). All 14 `.doc` files
        # under `data/` are OLE2, so `python-docx` cannot open any of them.
        # wvHtml emits real <table>/<tr>/<td>, which the stdlib `html.parser`
        # then reads - no extra Python dependency. It costs ~1 MB, against the
        # ~400 MB LibreOffice would cost for the same job; LibreOffice is not
        # installed in this image, so EMF/WMF images have no fallback path here.
        wv \
        # `pip` for Python package management (python3 is pre-installed in Ubuntu Noble)
        python3-pip \
    # Make `python` an alias for `python3`
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    # Clean up the package manager's local repository of retrieved package files
    # and remove the package lists that were downloaded earlier
    # to reduce the size of the final Docker image
    && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# ODA File Converter: the DWG -> DXF step of the drawing pipeline (task 0040).
#
# The package is downloaded at build time from a project-controlled mirror, so a
# fresh clone builds with nothing to prepare by hand. It cannot come from ODA
# directly: opendesign.com serves the converter behind a registration form and
# per-session URLs, and it publishes only the current release - a link there is
# neither stable nor reachable from a build. The mirror pins one known version
# instead, which is also what makes the build reproducible.
#
# ODA_URL is an ARG so a build can point at a different mirror or version
# without editing this file:
#   docker compose build --build-arg ODA_URL=...
#
# The download and the install share one RUN layer, and the .deb is removed
# inside it. Splitting them would leave the package in its own layer forever,
# even after a later `rm` - layers only ever add.
#
# The package declares no `Depends` at all and bundles its own Qt 6, so apt
# resolves nothing for it - every shared library it needs has to be named here.
# It ships a single platform plugin, `libqxcb.so` (no offscreen plugin), so an X
# server stays mandatory - that is what `xvfb` is for - and the plugin needs the
# X11 libraries below. `libxcb-util.so.0`, which ODA's own release notes mention
# as a workaround for modern Ubuntu, is not among them.
#
# `libfontconfig1` is for the executable itself, not the plugin, and it is the
# reason the `ldd` check below exists. The original list came from `ldd` on the
# bundled plugin alone, so the binary's own dependencies were never checked; in
# the development image they happened to arrive with ffmpeg, poppler and
# tesseract, and dropping those three (task 0072) took fontconfig with them. The
# failure surfaced only at the first conversion, as `return code = 127`.
#
# `libxcb-shape0` the plugin needs and the old list missed - found by the `ldd`
# check on the very next build, which is what it is for. The other xcb libraries
# named here are the ones apt does not pull in on their own: `libxcb-util1`,
# `libxcb-render0` and the rest arrive as dependencies of `libxcb-image0`.
#
# The check deliberately covers the executable and the platform plugins only,
# because those are what a conversion loads. Widening it to every bundled `.so`
# would drag in the dependencies of Qt modules this tool never opens - Qt's print
# support wants libcups - and the build would fail over a library nothing uses.
#
# The `chmod` calls repair the package's own permissions: it installs its tree,
# `/usr/share/doc/ODAFileConverter` and even the shared `/usr/share/icons` and
# `icons/hicolor` as world-writable (15 paths, 12 of them directories). A
# world-writable `plugins/platforms/` lets anyone drop a Qt plugin that the
# converter then loads, and a world-writable `qt.conf` can redirect the plugin
# search path. Symbolic `go-w` is deliberate - it strips only the write bits and
# leaves execute alone. The `test` that follows keeps the fix honest if a future
# package version adds new paths.
#
# The closing checks make a broken install fail the build here instead of at the
# first conversion. `command -v` proves the launcher is on PATH; `ldd` proves the
# libraries are actually there. The loader stops at the first library it cannot
# find, so a runtime failure names one at a time - `ldd` names them all at once,
# which is the difference between one rebuild and five.
ARG ODA_URL=https://www.opendesign.com/guestfiles/get?filename=ODAFileConverter_QT6_lnxX64_8.3dll_27.1.deb
RUN set -eux; \
    test "$(dpkg --print-architecture)" = "amd64"; \
    package=/tmp/ODAFileConverter.deb; \
    if ! curl -fsSL --retry 3 --retry-connrefused -o "${package}" "${ODA_URL}"; then \
        echo "error: could not download the ODA File Converter from:" >&2; \
        echo "  ${ODA_URL}" >&2; \
        echo "Check the network, or point the build at another copy:" >&2; \
        echo "  docker compose build --build-arg ODA_URL=..." >&2; \
        exit 1; \
    fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        xvfb \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0 \
        libfontconfig1 \
        libxcb-shape0; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${package}"; \
    rm -f "${package}"; \
    chmod go-w /usr/share/icons; \
    chmod -R go-w /usr/bin/ODAFileConverter /usr/bin/ODAFileConverter_*/ \
                  /usr/share/doc/ODAFileConverter /usr/share/icons/hicolor; \
    test "$(find /usr/bin/ODAFileConverter /usr/bin/ODAFileConverter_*/ \
                 /usr/share/icons -perm -o+w | wc -l)" = "0"; \
    command -v ODAFileConverter; \
    { for binary in /usr/bin/ODAFileConverter_*/ODAFileConverter \
                    /usr/bin/ODAFileConverter_*/plugins/platforms/*.so; do \
          [ -e "${binary}" ] || continue; \
          ldd "${binary}" | awk -v b="${binary}" '/not found/ {print b ": " $1}'; \
      done; } | sort -u > /tmp/oda-missing; \
    if [ -s /tmp/oda-missing ]; then \
        echo "error: the converter is missing shared libraries:" >&2; \
        cat /tmp/oda-missing >&2; \
        echo "Find the package that provides each (apt-file search <name>) and add" >&2; \
        echo "it to the apt list above, with the reason." >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/oda-missing; \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Pin the Qt platform plugin. VS Code Dev Containers exports WAYLAND_DISPLAY, so
# Qt tries the "wayland" plugin first, but the ODA package ships only
# `libqxcb.so` - the probe can therefore only fail, and it prints a warning to
# stderr. That warning is not cosmetic: on Linux `ezdxf.addons.odafc` treats any
# non-empty stderr as a failed conversion (odafc.py, `_odafc_failed`), so a
# perfectly good DWG comes back as UnknownODAFCError with "return code = 0".
# Naming the only available plugin removes the probe and keeps stderr empty.
ENV QT_QPA_PLATFORM=xcb

# Same reason, second warning: with no XDG_RUNTIME_DIR, Qt prints
# "QStandardPaths: XDG_RUNTIME_DIR not set, defaulting to '/tmp/runtime-ubuntu'"
# and `odafc` again reads a perfectly good conversion - "return code = 0" - as a
# failure. Measured in the container, not guessed.
#
# `/home/ubuntu/.runtime` rather than somewhere under `/tmp`: the directory has to
# exist and be private to the user, or Qt swaps this warning for a complaint about
# ownership. Created below, after `USER ubuntu`, so it belongs to that user.
ENV XDG_RUNTIME_DIR=/home/ubuntu/.runtime

# --- Python packages -------------------------------------------------------
#
# These two layers come LAST among the root-user steps on purpose (task 0054).
# Docker invalidates the layer you changed and everything after it, and these are
# the files we edit most often: with the pip layer placed BEFORE the ODA install,
# a one-line change to requirements.txt also rebuilt ODA and cost 87 s instead of
# 6 s. Stable steps first, volatile last.
#
# They must stay above `USER ubuntu`: pip run as an unprivileged user silently
# installs into ~/.local, which lives in the container's writable layer and is lost
# on every rebuild. That is exactly the defect this task removes - as root the
# packages land in /usr/local/lib/python3.12/dist-packages, inside the image.
#
# `--break-system-packages` is required because the interpreter is apt-managed
# (PEP 668). It is safe here and not a hack we regret: this container is
# disposable and rebuilt often, so a conflict with an apt `python3-*` upgrade is
# resolved by rebuilding instead of by hand.
#
# The package lists are written inline rather than read from a requirements file,
# so this Dockerfile builds on its own with no build context to prepare. Each
# list is a heredoc: pins stay one-per-line and reviewable, and the file never
# enters an image layer.

# Dependencies that no pyproject.toml owns (task 0052).
#
# What the `agent` package itself declares does NOT belong here. Its runtime
# closure is pinned in the next layer, and the package is bound into the
# interpreter by `agent/scripts/container-setup.sh` on every container start.
#
# Everything below lives here only until a domain package with its own
# pyproject.toml exists; task 0056 decides where that package goes. Versions are
# pinned because these modules are read as contracts, not as documentation.
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /dev/stdin <<'EOF'
# `ezdxf.addons.odafc` is the working interface to ODA File Converter - notably
# it runs the converter without a timeout, which the caller has to supply
# (task 0051).
ezdxf==1.4.4

# Cost-estimation input formats (task 0061). The `.doc` reader is not here: it is
# the apt package `wv`, installed above.

# Reads both `.xlsx` and `.xls` through one interface, which is why it replaced
# the `xlrd` + external-converter pair. Verified on the real files under `data/`:
# a 16-sheet `.xls` opens directly, and a CENKROS export is read out to column 91
# - the range where prices hide well past `I:J`.
python-calamine==0.8.2

# Writes the auditable XLSX report. Read-only work goes through calamine above;
# `openpyxl` cannot read `.xls` at all.
openpyxl==3.1.5

# Text, tables and word coordinates from PDF - the technical reports and drawing
# legends that carry meaning no drawing holds. Verified on `data/`: a floor plan
# yields its `LEGENDA ZNAČIEK` and 8 tables.
pdfplumber==0.11.10
EOF

# The runtime closure of `openai-codex`, pinned - and nothing else. This image
# carries no pytest, ruff or mypy: it runs the pipeline, it does not develop it
# (developer's decision 2026-08-04). Consequence worth knowing: `agent/tests` is
# visible through the mount but cannot be run here. Use the development container.
#
# The closure is pinned inline below. Regenerate it after changing the
# `openai-codex` version, and paste the result back into this heredoc:
#
#   pip install --dry-run --ignore-installed --report r.json 'openai-codex==0.144.4'
#
# `agent` itself is NOT installed at build time: an editable install records a
# path under /mnt, which does not exist until the container runs. `hatchling` and
# `editables` are here so that `scripts/container-setup.sh` can bind the package
# offline at start, with `--no-build-isolation`, instead of fetching a build
# environment on every boot.
#
# `packaging` goes first and separately: the base image carries it as the dpkg
# package `python3-packaging` (24.0), pip cannot uninstall a dpkg-managed package
# ("RECORD file not found"), and `hatchling` needs >=24.2 - so installing it in one
# step aborts. `--ignore-installed` leaves dpkg's copy alone and puts the newer one
# in /usr/local/lib/python3.12/dist-packages, which sys.path reaches BEFORE
# /usr/lib/python3/dist-packages, so it wins. `pipx` is the only dpkg dependent and
# asks for >=20, so it keeps working.
RUN set -eux; \
    python3 -m pip install --no-cache-dir --break-system-packages \
        --ignore-installed "packaging==26.2"; \
    python3 -m pip install --no-cache-dir --break-system-packages \
        "hatchling==1.31.0" "editables==0.6" -r /dev/stdin <<'EOF'
# Locked runtime dependency closure for openai-codex==0.144.4.
annotated-types==0.7.0
openai-codex-cli-bin==0.144.4
openai-codex==0.144.4
pydantic==2.13.4
pydantic_core==2.46.4
typing-inspection==0.4.2
typing_extensions==4.16.0
EOF

# File logging is ON in this image, and the marker is how (task 0066). It keys off
# this file and nothing else: an environment variable like IN_DOCKER can be set by
# anyone, whereas an image that lacks the path has to forbid nothing.
#
# KEEP IT. The name says "dev-profile" for historical reasons and reads like
# something a production image should not have - but the transcripts it enables are
# wanted here: they are the material for distilling how the pipeline is actually
# run (developer's decision 2026-08-04). Removing this line silently turns the
# logs off.
RUN mkdir -p /etc/agent \
    && printf 'devcontainer\n' > /etc/agent/dev-profile

# Allow ubuntu user to execute sudo without a password
RUN echo "ubuntu ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/ubuntu

# Use the created user to run the container
USER ubuntu

# Add user-local bin to PATH (for pip-installed scripts)
ENV PATH="/home/ubuntu/.local/bin:$PATH"

# The `preserved` directory is the mount point of this container's one named
# volume: the agent's task directory and its Codex home, both outside the
# repository on purpose (task 0068). Created here so the volume inherits the
# `ubuntu` user instead of root.
#
# `/home/ubuntu/workspaces` is gone with it - a leftover of the base template that
# nothing mounted and nothing wrote to (task 0072).
RUN mkdir -p /home/ubuntu/preserved
# Set the bash history file to preserved location
ENV HISTFILE=/home/ubuntu/preserved/.bash_history

# No VS Code server directory here: its volume is gone from this compose, and
# nothing attaches an editor to this container (task 0072).
# Create empty config files and tool state directories in user's home directory
# NOTE: Created here explicitly to ensure they have `ubuntu` as owner.
#
# No `~/.claude` and no Claude payload directory: Claude Code is not installed in
# this image (its installer lives in the development container's post-create), and
# this container runs the cli agent with its SDK and nothing else (developer's
# decision 2026-08-04). `~/.codex` stays because the runtime may still touch it,
# but the client's own Codex home is `~/preserved/agent-home`.
# `.gitconfig` is created empty so `git config user.name` has a file to read.
#
# IT WILL BE EMPTY, and that is a live consequence: the session transcript falls
# back to an unattributed author, so two people's logs cannot be told apart after a
# merge - which is what the transcripts are collected for. Set the identity in this
# image, or mount the host's `~/.gitconfig` read-only, before two people start
# distilling their runs.
#
# No `.hgrc` (mercurial dropped) and no `~/.ssh` (nothing mounts or uses it).
RUN touch /home/ubuntu/.gitconfig \
    && mkdir -p /home/ubuntu/.codex \
    && mkdir -p -m 700 "${XDG_RUNTIME_DIR}"

# No Node.js. It was installed for Claude Code, which this image does not carry;
# `openai-codex` ships its own bundled runtime, so the pipeline needs no separate
# Node (task 0072). Dropping it also removes a network fetch from the build.
#
# `libatomic1` further up stays: it is cheap, and taking it out belongs to a pass
# over the base packages rather than to this change.

WORKDIR /mnt
